# Copy from app/api/.env or set directly
# The tool uses the same AI provider as the API.

# Paid model (Moonshot) — recommended for schema extraction (larger context)
MOONSHOT_API_KEY=your_moonshot_key_here
MOONSHOT_BASE_URL=https://api.moonshot.ai/v1
MOONSHOT_MODEL=moonshot-v1-128k

# Fallback: OpenAI (Luna is too limited for large PDF extraction)
OPENAI_API_KEY=your_openai_key_here
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o

# Which provider to use: "moonshot" or "openai"
AI_PROVIDER=moonshot
