# Server
PORT=4000
NODE_ENV=development
# Browser origin allowed by CORS (Vite dev server or production UI URL)
CLIENT_ORIGIN=http://localhost:5173

# Supabase (Project Settings → API)
# service_role key MUST stay on the backend only — never expose to the frontend
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# Require email confirmation before login (also enable Confirm email in Supabase Auth).
# Keep false for local/demo without mail; set true in production.
REQUIRE_EMAIL_CONFIRMATION=false

# Free plan — Standard AI (OpenAI GPT-5.6 Luna, server-side only)
# Luna is OpenAI's cheapest/fastest GPT-5.6 tier (same family as ChatGPT Free).
OPENAI_API_KEY=your_openai_key_here
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-5.6-luna

# Paid plans — Advanced AI (Moonshot, server-side only)
MOONSHOT_API_KEY=your_moonshot_key_here
MOONSHOT_BASE_URL=https://api.moonshot.ai/v1
MOONSHOT_MODEL=moonshot-v1-8k

# Stripe (later)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
