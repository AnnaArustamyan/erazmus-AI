# =============================================================================
# Erasmus AI Assistant — Environment Variables
# See docs/ENV_SETUP.md for step-by-step setup instructions
# =============================================================================

# --- App ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development

# --- Database (local: npm run docker:up) ---
DATABASE_URL="postgresql://erazmus:erazmus_dev@localhost:5433/erazmus_ai?schema=public"

# --- Auth.js (REQUIRED) ---
# Generate with: openssl rand -base64 32
AUTH_SECRET=
AUTH_URL=http://localhost:3000

# --- Google OAuth (optional) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
NEXT_PUBLIC_GOOGLE_AUTH_ENABLED=false

# --- Moonshot AI (REQUIRED for chat) ---
# Get key at: https://platform.moonshot.cn/
MOONSHOT_API_KEY=
MOONSHOT_API_URL=https://api.moonshot.cn/v1
MOONSHOT_MODEL=moonshot-v1-8k

# --- Redis (local: npm run docker:up) ---
REDIS_URL=redis://localhost:6379

# --- Supabase Storage (Phase 3 — optional locally) ---
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
SUPABASE_STORAGE_BUCKET=documents

# --- Stripe (Phase 3 — use test keys) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_BASIC=
STRIPE_PRICE_PRO=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# --- Email (Phase 3) ---
RESEND_API_KEY=
EMAIL_FROM=noreply@erazmus.ai

# --- Monitoring (Phase 4) ---
SENTRY_DSN=

# --- Worker (Railway background service) ---
WORKER_MODE=false
